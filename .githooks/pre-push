#!/bin/sh
set -eu

remote_name=${1:-origin}
repo_root=$(git rev-parse --show-toplevel)
checker="$repo_root/tools/analysis/changelog_guard.py"
zero_sha=0000000000000000000000000000000000000000
result=0

# Probe each candidate by running it: Windows' Store alias `python3` exists but only prints an install hint.
python_bin=
for candidate in "${PYTHON:-}" python3 python; do
    if [ -n "$candidate" ] && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
        python_bin=$candidate
        break
    fi
done
if [ -z "$python_bin" ]; then
    echo "changelog guard: Python 3.10 or newer is required; set PYTHON to an executable path" >&2
    exit 2
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    # The branch being updated decides, not the local name: `git push origin HEAD:main` from a detached
    # worktree has local_ref HEAD and must still be checked and watched.
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    [ "$local_sha" != "$zero_sha" ] || continue

    base_sha=$remote_sha
    if [ "$remote_sha" = "$zero_sha" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        remote_head=$(git symbolic-ref --quiet --short "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)
        if [ -n "$remote_head" ]; then
            base_sha=$(git merge-base "$local_sha" "$remote_head" 2>/dev/null || printf '%s' "$zero_sha")
        else
            base_sha=$zero_sha
        fi
    fi

    "$python_bin" "$checker" "$base_sha" "$local_sha" --repo "$repo_root" || result=1
    pushed="${pushed:-} $local_sha"
done

# Every pushed commit gets a detached CI watcher (`tare ci watch`): a red run becomes an alert that agents
# are shown before they can end a turn, plus a Windows notification. Machines without the product skip it.
tare_cmd="${LOCALAPPDATA:-}/tare.tools/product/tare.cmd"
if [ "$result" = 0 ] && [ -n "${LOCALAPPDATA:-}" ] && [ -f "$tare_cmd" ] && command -v powershell.exe >/dev/null 2>&1; then
    for sha in ${pushed:-}; do
        powershell.exe -NoProfile -Command "Start-Process -WindowStyle Hidden -FilePath '$tare_cmd' \
-ArgumentList 'ci','watch','$repo_root','$sha'" >/dev/null 2>&1 || true
    done
fi

if [ "$result" -eq 0 ]; then
    echo "PUSH_REMINDER=review docs, handoff, backlog, and changelog when applicable; after push, watch GitHub Actions to a terminal result" >&2
fi

exit "$result"
