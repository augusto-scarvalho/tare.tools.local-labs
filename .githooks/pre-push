#!/bin/sh
set -eu

remote_name=${1:-origin}
repo_root=$(git rev-parse --show-toplevel)
checker="$repo_root/tools/analysis/changelog_guard.py"
zero_sha=0000000000000000000000000000000000000000
result=0

if [ -n "${PYTHON:-}" ]; then
    python_bin=$PYTHON
elif command -v python3 >/dev/null 2>&1; then
    python_bin=python3
elif command -v python >/dev/null 2>&1; then
    python_bin=python
else
    echo "changelog guard: Python 3 is required" >&2
    exit 2
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    [ "$local_sha" != "$zero_sha" ] || continue

    base_sha=$remote_sha
    if [ "$remote_sha" = "$zero_sha" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        remote_head=$(git symbolic-ref --quiet --short "refs/remotes/$remote_name/HEAD" 2>/dev/null || true)
        if [ -n "$remote_head" ]; then
            base_sha=$(git merge-base "$local_sha" "$remote_head" 2>/dev/null || printf '%s' "$zero_sha")
        else
            base_sha=$zero_sha
        fi
    fi

    "$python_bin" "$checker" "$base_sha" "$local_sha" --repo "$repo_root" || result=1
done

if [ "$result" -eq 0 ]; then
    echo "PUSH_REMINDER=review docs, handoff, backlog, and changelog when applicable; after push, watch GitHub Actions to a terminal result" >&2
fi

exit "$result"
