# Python bytecode / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual envs (the sglang venv lives in WSL, outside this tree, but guard anyway)
.venv/
venv/
env/

# The SQLite store is a BINARY, secondary record. The durable evidence is the JSON in
# runs/ (each run's raw record, which STATUS.md's provenance depends on); the .db is
# derived from those and is git-hostile (binary diffs, merge conflicts). Keep it out.
runs/*.db
runs/*.db-journal
runs/*.db-wal

# Transient llama.cpp server log (rotated per run; not evidence)
llama.log

# Driver stdout redirects (the report is regenerable from runs/<dir>/records.json)
runs_*.log
# A2 driver stdout redirects (the structured data lives in runs/a2/*.json)
runs/a2/_*.log
runs/a2/_log_*.txt

# evalplus scoring intermediates (derived from the samples.jsonl; regenerable via score_subset.py)
runs/quality/*.padded.jsonl
runs/quality/*_eval_results.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
