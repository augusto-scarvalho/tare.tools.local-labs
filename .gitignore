# Python bytecode / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual envs (e.g. sglang, evalplus in WSL or Windows)
.venv/
venv/
env/
*_env/
*-venv/

# Durable SQLite store is a binary derivative; durable evidence lives in JSON/JSONL
runs/*.db
runs/*.db-journal
runs/*.db-wal

# Log files and runtime outputs
*.log
.coverage
!runs/research/**/runner.stderr.log
runs_*.log
llama.log
logs/
*.pid
runs/a2/_*.log
runs/a2/_log_*.txt

# Heavy audit bundles, zip archives, and large adapter weights
*.zip
*.pt
.harness/artifacts/
.harness/artifacts_ext/
runs/**/adapter_*/
runs/research/ADAPT-00*/raw/**/adapter/
# PEFT exports duplicate the same ~19 MiB tokenizer payload in every arm.
# Keep adapter configs, templates, metrics, and weights; load the frozen base
# tokenizer separately. The excluded derivative hash is recorded in the
# canonical 2026-08-25 remediation handoff.
runs/research/ADAPT-*/raw/**/adapter/tokenizer.json
# Successor packets keep the same frozen base tokenizer outside each adapter.
runs/research/BACKLOG-*/raw/**/adapter/tokenizer.json
# Physical model/codec derivatives are too large for ordinary GitHub storage.
# Their byte counts and SHA-256 identities remain committed in packet receipts;
# source dependencies use external_source_receipts in the canonical backlog.
runs/research/BACKLOG-*/raw/**/*.gguf
runs/research/BACKLOG-*/raw/**/*.npy
runs/research/BACKLOG-*/raw/**/*.bin
# Multi-seed PEFT checkpoints are regenerable training products. Keep only the
# two explicitly referenced by downstream packet source_artifacts.
runs/research/BACKLOG-ADAPT-TRACE-DISTILL-*/raw/checkpoints/**/adapter_model.safetensors
!runs/research/BACKLOG-ADAPT-TRACE-DISTILL-03/raw/checkpoints/seed_20260824_full_trace/adapter_model.safetensors
runs/research/BACKLOG-ADAPT-TRAIN-01/raw/checkpoint_seed_*/adapter_model.safetensors
!runs/research/BACKLOG-ADAPT-TRAIN-01/raw/checkpoint_seed_20260824/adapter_model.safetensors
runs/**/canary_*/
runs/**/gates/*/

# evalplus scoring intermediates (derived from samples.jsonl; regenerable)
runs/quality/*.padded.jsonl
runs/quality/*_eval_results.json

# Scratch workspace and ad-hoc outputs
scratch/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Historical handoff artifacts
_handoff/
