# Python bytecode / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual envs (e.g. sglang, evalplus in WSL or Windows)
.venv/
venv/
env/
*_env/
*-venv/

# Durable SQLite store is a binary derivative; durable evidence lives in JSON/JSONL
runs/*.db
runs/*.db-journal
runs/*.db-wal

# Log files and runtime outputs
*.log
runs_*.log
llama.log
runs/a2/_*.log
runs/a2/_log_*.txt

# Heavy audit bundles, zip archives, and large adapter weights
*.zip
.harness/artifacts/
.harness/artifacts_ext/
runs/**/adapter_*/
runs/**/canary_*/
runs/**/gates/*/

# evalplus scoring intermediates (derived from samples.jsonl; regenerable)
runs/quality/*.padded.jsonl
runs/quality/*_eval_results.json

# Scratch workspace and ad-hoc outputs
scratch/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
