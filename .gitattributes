# This project straddles Windows and WSL. A file authored on Windows with CRLF that is
# then executed by a Linux interpreter fails with a `\r`-tainted error -- exactly the
# breakage seen in the setup scripts. Normalise to LF in the repository so a WSL checkout
# is always clean; PowerShell scripts keep CRLF, which some Windows tooling still prefers.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Data records: text, LF, but never touched by line-ending magic on content.
*.json text eol=lf
*.jsonl text eol=lf

# Raw research receipts are immutable evidence. Preserve their original bytes
# (including historical line endings) so external SHA-256 ledgers remain valid.
runs/research/**/raw/*.json binary

# Independent reviews are hash-bound historical evidence too. Keep their
# original bytes while retaining ordinary textual diffs.
runs/research/**/REVIEW.json -text

# Packet results and declared stderr inputs can be SHA-256-bound by receipts.
# Preserve their authored bytes so a Linux checkout validates the same object
# that the Windows research host validated.
runs/research/**/RESULT.md -text -eol -diff
runs/research/**/runner.stderr.log -text -eol -diff

# Autonomous SLX08 terminal states are frozen inputs to successor packets.
# Preserve their Windows-authored bytes so their declared SHA-256 values are
# identical on Windows and Linux checkouts.
runs/autonomous/SLX08-RELEVANCE-R6-2026-08-30/FINAL.json -text -eol -diff
runs/autonomous/SLX08-RELEVANCE-R6-2026-08-30/WORKER_EXIT.json -text -eol -diff
runs/autonomous/SLX08-RELEVANCE-R8-2026-08-30/FINAL.json -text -eol -diff
runs/autonomous/SLX08-RELEVANCE-R8-2026-08-30/WORKER_EXIT.json -text -eol -diff
runs/autonomous/SLX08-RELEVANCE-R9-2026-08-30/FINAL.json -text -eol -diff
runs/autonomous/SLX08-RELEVANCE-R9-2026-08-30/WORKER_EXIT.json -text -eol -diff

# Binary — never diff or convert.
*.db binary
*.gguf binary
*.png binary
*.jpg binary
